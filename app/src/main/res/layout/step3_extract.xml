<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ===== JSON 模式：树 + 规则 ===== -->
    <LinearLayout
        android:id="@+id/json_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_tree_hint" />

        <LinearLayout
            android:id="@+id/box_tree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="8dp" />
    </LinearLayout>

    <!-- ===== 文本模式：原文 + 正则/整段抽取 ===== -->
    <LinearLayout
        android:id="@+id/text_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_text_response" />

        <TextView
            android:id="@+id/tv_text_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            style="@style/TextAppearance.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_regex_pattern" />

        <EditText
            android:id="@+id/inp_regex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:hint="@string/hint_regex"
            android:inputType="text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/regex_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inp_regex_alias"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_regex_alias"
                android:inputType="text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_add_regex"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_regex_rule"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_text"
            style="@style/Widget.Material3.Button.OutlinedButton.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_text_rule" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/label_rules" />

    <LinearLayout
        android:id="@+id/box_rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/rules_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="12sp" />
</LinearLayout>
