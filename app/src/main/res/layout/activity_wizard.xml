<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 头部：返回 + 标题 + 步骤指示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_prev"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/accent"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wz_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wz_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/step_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot0" android:layout_width="7dp" android:layout_height="7dp"
                android:layout_marginLeft="4dp" android:background="@color/accent" />
            <View
                android:id="@+id/dot1" android:layout_width="7dp" android:layout_height="7dp"
                android:layout_marginLeft="4dp" android:background="@color/rule" />
            <View
                android:id="@+id/dot2" android:layout_width="7dp" android:layout_height="7dp"
                android:layout_marginLeft="4dp" android:background="@color/rule" />
            <View
                android:id="@+id/dot3" android:layout_width="7dp" android:layout_height="7dp"
                android:layout_marginLeft="4dp" android:background="@color/rule" />
        </LinearLayout>
    </LinearLayout>

    <!-- 步骤内容 -->
    <ScrollView
        android:id="@+id/step_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/sec_head1"
                style="@style/TextAppearance.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="2dp"
                android:text="@string/sec_source"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <include
                android:id="@+id/step1"
                layout="@layout/step1_source" />

            <TextView
                android:id="@+id/sec_head2"
                style="@style/TextAppearance.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="2dp"
                android:text="@string/sec_preview"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <include
                android:id="@+id/step2"
                layout="@layout/step2_preview" />

            <TextView
                android:id="@+id/sec_head3"
                style="@style/TextAppearance.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="2dp"
                android:text="@string/sec_extract"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <include
                android:id="@+id/step3"
                layout="@layout/step3_extract" />

            <TextView
                android:id="@+id/sec_head4"
                style="@style/TextAppearance.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="2dp"
                android:text="@string/sec_editor"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <include
                android:id="@+id/step4"
                layout="@layout/step4_editor" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_prev"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="@string/btn_prev" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_next" />
    </LinearLayout>
</LinearLayout>
